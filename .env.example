# Environment configuration for Password Manager
# Copy this file to .env and adjust values as needed.

# Network
PM_HOST=0.0.0.0
PM_PORT=8080

# Database
PM_DB_DIR=.
PM_DB_NAME=vault.db

# Security (leave commented to auto-generate on first run)
# PM_SECRET_KEY=your-persistent-secret-key-here

# Auto-lock timeout in minutes (0 = disabled)
PM_AUTO_LOCK_MINUTES=5

# Rate limiting: max unlock attempts per minute
PM_RATE_LIMIT_UNLOCK=5 per minute

# Session lifetime in hours
PM_SESSION_LIFETIME_HOURS=8

# PBKDF2 iterations (600000 = OWASP recommended for SHA-256)
PM_PBKDF2_ITERATIONS=600000
